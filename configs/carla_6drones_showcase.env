# AERION CARLA + AirSim 3-drone showcase preset.
# Sourced by scripts/run_phase4_carla_showcase.sh.
# Values use ${VAR:=...}, so command-line env overrides still win.

: "${DRONE_COUNT:=3}"
: "${AIRSIM_VIEW_MODE:=Manual}"
: "${CONTROL_MODE:=showcase}"
: "${PATTERNS:=TRIANGLE,LINE_H,ECHELON_R,CIRCLE}"

# Motion profile
: "${VELOCITY:=5.0}"
: "${SEGMENT_SEC:=5.4}"
: "${TICK_HZ:=7.0}"
: "${COMMAND_STAGGER_MS:=16}"
: "${CAPTURE_SEC:=1.6}"
: "${PRE_SETTLE:=1}"
: "${PRE_SETTLE_RETRIES:=3}"
: "${FORMATION_HOLD_SEC:=3.0}"
: "${CIRCLE_HOLD_SEC:=3.0}"

# Formation safety
: "${MIN_SEPARATION_M:=6.2}"
: "${TRANSITION_Z_LIFT:=0.8}"
: "${Z_LIFT_GAIN:=0.28}"
: "${Z_ALIGN_SEC:=0.8}"
: "${COLLISION_HARD_MIN_M:=3.6}"
: "${COLLISION_MITIGATION_ROUNDS:=3}"
: "${CA_CROSSING_PENALTY:=20.0}"
: "${CA_CONTINUITY_PENALTY:=6.0}"
: "${ROLE_ASSIGNMENT:=fixed}"
: "${CA_NEAR_DIST_M:=8.0}"
: "${CA_SLOWDOWN_FACTOR:=0.70}"
: "${REANCHOR_GAIN:=0.85}"

# Z stabilization
: "${Z_COMMAND_DEADBAND_M:=0.26}"
: "${Z_COMMAND_MAX_STEP_M:=0.22}"
: "${Z_COMMAND_HOLD_BAND_M:=0.12}"
: "${Z_COMMAND_COOLDOWN_SEC:=0.55}"
: "${Z_COLLISION_XY_THRESH_M:=4.8}"
: "${Z_COLLISION_MIN_DZ_M:=1.35}"
: "${Z_COLLISION_DZ_GAIN_PER_XY_M:=0.45}"
: "${SAFETY_FLOOR_Z:=-0.20}"
: "${SAFETY_RECOVERY_Z:=-3.50}"

# Post-formation action
: "${POST_ACTION_ENABLED:=1}"
: "${POST_ACTION_STYLE:=mixed}"
: "${POST_ACTION_SEGMENT_SEC:=4.8}"
: "${POST_LINE_TRANSLATE_M:=18.0}"
: "${POST_ROTATE_DEG_LIST:=90}"
: "${POST_ACTION_VELOCITY_SCALE:=1.22}"
: "${POST_ACTION_PAUSE_SEC:=1.2}"
: "${TRANSITION_WHILE_MOVING:=0}"

# Camera and AirSim
: "${THIRD_PERSON_FOLLOW:=1}"
: "${THIRD_PERSON_MODE:=center_follow}"
: "${THIRD_PERSON_CAMERA_NAME:=0}"
: "${THIRD_PERSON_DISTANCE_M:=24}"
: "${THIRD_PERSON_HEIGHT_M:=10}"
: "${THIRD_PERSON_LOOKAHEAD_M:=3}"
: "${THIRD_PERSON_UPDATE_HZ:=6.0}"
: "${THIRD_PERSON_VIEW_AZIMUTH_DEG:=135}"
: "${THIRD_PERSON_VIEW_ELEVATION_BIAS_M:=0.0}"
: "${CAM_CENTER_SMOOTH_ALPHA:=0.16}"
: "${CAM_DIR_SMOOTH_ALPHA:=0.25}"
: "${CAM_YAW_RATE_LIMIT_DEG_S:=24}"
: "${CAM_MOTION_DEADBAND_MPS:=0.45}"
: "${SUBWINDOW_CAMERA_NAME:=front_center}"
: "${SUBWINDOW_VEHICLE:=drone1}"
: "${AUTO_CAMERA_PROBE:=1}"
: "${AIRSIM_IP:=127.0.0.1}"
: "${AIRSIM_PORT:=41451}"
: "${CYCLES:=0}"
